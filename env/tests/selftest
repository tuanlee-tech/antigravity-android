#!/usr/bin/env bash
# selftest -- offline checks for pkg core (no network).
set -uo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)"
PKG_DIR="$SELF/../pkg"
PKG_LIB="$PKG_DIR/lib"
PKG_SELF="$PKG_DIR"

PREFIX="$(mktemp -d)/usr"
export PREFIX

. "$PKG_LIB/util.sh"
. "$PKG_LIB/version.sh"
. "$PKG_LIB/index.sh"
. "$PKG_LIB/db.sh"
. "$PKG_LIB/deb.sh"
. "$PKG_LIB/resolver.sh"
ensure_dirs

fail=0
ok()   { printf 'PASS  %s\n' "$1"; }
bad()  { printf 'FAIL  %s\n' "$1"; fail=$((fail + 1)); }

# ---- version comparison ----------------------------------------------------
vc() { # A B EXPECTED
    local got; got="$(deb_vercmp "$1" "$2")"
    [ "$got" = "$3" ] && ok "vercmp $1 $2 = $3" || bad "vercmp $1 $2 = $3 (got $got)"
}
vc 1.0.0       1.0.0       0
vc 1.0.0       1.0.1      -1
vc 1.0.1       1.0.0       1
vc 2.0         10.0       -1
vc 1.0~rc1     1.0        -1
vc 1:1.0       2.0         1
vc 1.0-1       1.0-2      -1
vc 1.0         1.0-0       0
vc 1.0-1       1.0-1       0
vc 1.2.3-4     1.2.3-4build1 -1
vc 1.0a        1.0b       -1
vc 1.0+really1.1 1.0       1

# ---- index parsing ---------------------------------------------------------
FIX="$SELF/fixtures/Packages"
[ "$(index_get "$FIX" hello 2)"    = "1.0.0" ]   && ok "index version"    || bad "index version"
[ "$(index_get "$FIX" hello 5)"    = "libhello (>= 1.0), world | glob" ] && ok "index depends" || bad "index depends"
[ "$(index_get "$FIX" world 4)"    = "yes" ]     && ok "index essential"  || bad "index essential"
[ "$(index_get "$FIX" world 7)"    = "glob" ]    && ok "index provides"   || bad "index provides"

# continuation line must not become a field
[ "$(index_get "$FIX" hello 1)"    = "hello" ]   && ok "index name"       || bad "index name"

# ---- db --------------------------------------------------------------------
printf 'bin/hello\nlib/libhello.so\n' | db_put hello 1.0.0 aarch64
[ "$(db_get hello version)" = "1.0.0" ] && ok "db get" || bad "db get"
db_exists hello && ok "db exists" || bad "db exists"
[ "$(db_owner bin/hello)" = "hello" ] && ok "db owner" || bad "db owner"
db_list | grep -q '^hello 1.0.0$' && ok "db list" || bad "db list"
db_remove hello
db_exists hello && bad "db remove" || ok "db remove"

# ---- version constraints ---------------------------------------------------
vs() { # V OP WANT EXPECT(0 ok,1 not)
    if ver_satisfies "$1" "$2" "$3"; then s=0; else s=1; fi
    [ "$s" = "$4" ] && ok "satisfies $1 $2 $3 = $4" || bad "satisfies $1 $2 $3 = $4 (got $s)"
}
vs 1.2.0 ">=" 1.0.0 0
vs 0.9   ">=" 1.0.0 1
vs 1.0   "="  1.0   0
vs 1.0   ">>" 1.0   1
vs 1:2.0 ">=" 2.0   0

# ---- dependency closure -----------------------------------------------------
cp "$FIX" "$PKG_INDEX/repo.1.Packages"
index_rebuild_all
resolved="$(resolve hello 2>/dev/null)"
[ "$resolved" = $'libhello\nworld\nhello' ] \
    && ok "dependency order + alternatives" || bad "dependency order + alternatives ($resolved)"
provided="$(resolve glob 2>/dev/null)"
[ "$provided" = "world" ] && ok "direct virtual provider" || bad "direct virtual provider ($provided)"
if resolve missing-package >/dev/null 2>&1; then
    bad "unresolved dependency rejected"
else
    ok "unresolved package rejected"
fi

# ---- .deb (ar + tar) -------------------------------------------------------
DEB="$SELF/fixtures/hello.deb"
if [ -f "$DEB" ]; then
    [ "$(ar_members "$DEB" | tr '\n' ' ')" = "debian-binary control.tar.xz data.tar.xz " ] \
        && ok "deb ar members" || bad "deb ar members"
    [ "$(deb_field "$DEB" Version)" = "2.12.3-1" ] && ok "deb control Version" || bad "deb control Version"
    [ "$(deb_field "$DEB" Depends)" = "libiconv" ] && ok "deb control Depends" || bad "deb control Depends"
    deb_files "$DEB" | grep -qx 'bin/hello' && ok "deb data files" || bad "deb data files"
else
    printf 'SKIP  deb checks (no fixtures/hello.deb)\n'
fi

# ---- dynamic notification bridge -------------------------------------------
NOTIFY_TMP="$(mktemp -d)"
mkdir -p "$NOTIFY_TMP/bin"
cat > "$NOTIFY_TMP/bin/rish" <<'EOF'
#!/system/bin/sh
printf '%s\n' "$*" >> "$AGY_NOTIFY_CAPTURE"
EOF
chmod +x "$NOTIFY_TMP/bin/rish"
export AGY_NOTIFY_CAPTURE="$NOTIFY_TMP/calls.log"
if PREFIX="$NOTIFY_TMP" bash "$SELF/../overlay/bin/agy-notify" cancel task_123 \
        && grep -Fq 'cmd notification cancel task_123' "$AGY_NOTIFY_CAPTURE"; then
    ok "agy-notify cancel forwards its positional tag"
else
    bad "agy-notify cancel forwards its positional tag"
fi
if PREFIX="$NOTIFY_TMP" bash "$SELF/../overlay/bin/agy-notify" cancel >/dev/null 2>&1; then
    bad "agy-notify rejects missing cancel tag"
else
    ok "agy-notify rejects missing cancel tag"
fi
if PREFIX="$NOTIFY_TMP" bash "$SELF/../overlay/bin/agy-notify" post -t "Test" -m "Msg" --tag "post_123" \
        && grep -Fq 'cmd notification post -S bigtext  -t Test post_123 Msg' "$AGY_NOTIFY_CAPTURE"; then
    ok "agy-notify post falls back cleanly without hardcoded logo"
else
    bad "agy-notify post falls back cleanly without hardcoded logo"
fi
rm -rf "$NOTIFY_TMP"
unset AGY_NOTIFY_CAPTURE

# ---- agy-upgrade HOME calculation -----------------------------------------
UPG_TMP="$(mktemp -d)"
calc_home="$(unset HOME; PREFIX="$UPG_TMP/usr" bash -c '
    SCRIPT_DIR="'"$SELF/../overlay/bin"'"
    export PREFIX="${PREFIX:-$(cd -- "$SCRIPT_DIR/.." 2>/dev/null && pwd)}"
    export HOME="${HOME:-$(dirname "$PREFIX")}"
    printf "%s" "$HOME"
')"
if [ "$calc_home" = "$UPG_TMP" ]; then
    ok "agy-upgrade HOME matches dirname PREFIX"
else
    bad "agy-upgrade HOME matches dirname PREFIX"
fi
rm -rf "$UPG_TMP"

# ---- pkg runtime bridge selective generation -------------------------------
BRIDGE_TMP="$(mktemp -d)"
mkdir -p "$BRIDGE_TMP/usr/bin" "$BRIDGE_TMP/runtime/bin"
touch "$BRIDGE_TMP/usr/bin/existing_bin" "$BRIDGE_TMP/usr/bin/new_bin"
# Verify pkg install_one bridge block logic creates bridge only for newly installed binary
pkg_files="bin/new_bin"
PREFIX="$BRIDGE_TMP/usr"
runtime_bin="$PREFIX/../runtime/bin"
if [ -d "$runtime_bin" ] && [ -n "$pkg_files" ]; then
    while IFS= read -r p; do
        case "$p" in
            bin/*)
                bname="${p#bin/}"
                case "$bname" in */*|"") continue ;; esac
                bin_file="$PREFIX/bin/$bname"
                [ -f "$bin_file" ] || [ -L "$bin_file" ] || continue
                if [ ! -f "$runtime_bin/$bname" ]; then
                    printf '#!/system/bin/sh\nexec "$PREFIX/bin/%s" "$@"\n' "$bname" > "$runtime_bin/$bname"
                    chmod 755 "$runtime_bin/$bname"
                fi
                ;;
        esac
    done <<< "$pkg_files"
fi
if [ -f "$BRIDGE_TMP/runtime/bin/new_bin" ] && [ ! -f "$BRIDGE_TMP/runtime/bin/existing_bin" ]; then
    ok "pkg generates bridges only for package binaries"
else
    bad "pkg generates bridges only for package binaries"
fi
rm -rf "$BRIDGE_TMP"

# ---- zero-Python ELF shell patching (patch_elf_shell + agy-fix-paths) ------
ELF_TMP="$(mktemp -d)"
mkdir -p "$ELF_TMP/usr/bin" "$ELF_TMP/usr/libexec/git-core"
ELF_GIT="$ELF_TMP/usr/bin/git"
ELF_HTTP="$ELF_TMP/usr/libexec/git-core/git-remote-http"
{
    printf '\x7fELF\x02\x01\x01\x00PADDING'
    printf '/data/data/com.termux/files/usr/bin/sh\0'
    printf 'TAIL_DECOY:/data/data/com.termux/files/usr/bin/sh_keep\0'
} > "$ELF_GIT"
cp "$ELF_GIT" "$ELF_HTTP"
chmod 750 "$ELF_GIT" "$ELF_HTTP"
orig_len="$(wc -c < "$ELF_GIT" | tr -d ' ')"
before_mode="$(stat -c '%a' "$ELF_GIT" 2>/dev/null || echo "")"

patch_elf_shell "$ELF_GIT"
new_len="$(wc -c < "$ELF_GIT" | tr -d ' ')"
after_mode="$(stat -c '%a' "$ELF_GIT" 2>/dev/null || echo "")"
if [ "$orig_len" = "$new_len" ] \
        && [ "$after_mode" = "$before_mode" ] \
        && ! LC_ALL=C tr '\000' '\n' < "$ELF_GIT" | grep -Fxq '/data/data/com.termux/files/usr/bin/sh' \
        && LC_ALL=C grep -aqF '/system/bin/sh' "$ELF_GIT" \
        && LC_ALL=C grep -aqF '/data/data/com.termux/files/usr/bin/sh_keep' "$ELF_GIT"; then
    ok "patch_elf_shell patches ELF NUL-terminated shell in-place preserving size, mode & decoy"
else
    bad "patch_elf_shell patches ELF NUL-terminated shell in-place preserving size, mode & decoy"
fi

PREFIX="$ELF_TMP/usr" bash "$SELF/../overlay/bin/agy-fix-paths" "$ELF_TMP/usr" >/dev/null 2>&1 || true
if [ "$(wc -c < "$ELF_HTTP" | tr -d ' ')" = "$orig_len" ] \
        && LC_ALL=C grep -aqF '/system/bin/sh' "$ELF_HTTP" \
        && ! LC_ALL=C tr '\000' '\n' < "$ELF_HTTP" | grep -Fxq '/data/data/com.termux/files/usr/bin/sh'; then
    ok "agy-fix-paths patches git-remote-http ELF without python3"
else
    bad "agy-fix-paths patches git-remote-http ELF without python3"
fi
rm -rf "$ELF_TMP"

# ---- agy-projects (list/scan/add/remove + UTF-8/spaces URI + atomic JSON) --
PROJ_TMP="$(mktemp -d)"
DOCS_TMP="$PROJ_TMP/Documents"
PSTORE_TMP="$PROJ_TMP/projects"
mkdir -p "$DOCS_TMP/plain app" "$DOCS_TMP/Dự Án Việt" "$DOCS_TMP/git-repo/.git"
printf 'ref: refs/heads/develop\n' > "$DOCS_TMP/git-repo/.git/HEAD"
export AGY_PROJECTS_DIR="$PSTORE_TMP"
export AGY_DOCS_DIR="$DOCS_TMP"
AGY_PROJ_BIN="$SELF/../overlay/bin/agy-projects"

scan_before="$(bash "$AGY_PROJ_BIN" scan "$DOCS_TMP")"
if printf '%s\n' "$scan_before" | grep -q $'^new\tgit\tgit-repo\t' \
        && printf '%s\n' "$scan_before" | grep -q $'^new\tfolder\tplain app\t'; then
    ok "agy-projects scan finds unloaded git and plain folders"
else
    bad "agy-projects scan finds unloaded git and plain folders ($scan_before)"
fi

add_out="$(bash "$AGY_PROJ_BIN" add "$DOCS_TMP/git-repo" "$DOCS_TMP/plain app" "$DOCS_TMP/Dự Án Việt")"
if printf '%s\n' "$add_out" | grep -q $'^added\t.*\tgit-repo\t' \
        && printf '%s\n' "$add_out" | grep -q $'^added\t.*\tplain app\t' \
        && printf '%s\n' "$add_out" | grep -q $'^added\t.*\tDự Án Việt\t'; then
    ok "agy-projects add registers git, space, and UTF-8 folders"
else
    bad "agy-projects add registers git, space, and UTF-8 folders ($add_out)"
fi

dup_out="$(bash "$AGY_PROJ_BIN" add "$DOCS_TMP/git-repo")"
if printf '%s\n' "$dup_out" | grep -q $'^exists\t'; then
    ok "agy-projects add is idempotent for duplicates"
else
    bad "agy-projects add is idempotent for duplicates ($dup_out)"
fi

json_list="$(bash "$AGY_PROJ_BIN" list --json)"
json_ok=1
if command -v python3 >/dev/null 2>&1 || command -v python >/dev/null 2>&1; then
    py_bin="python3"; command -v python3 >/dev/null 2>&1 || py_bin="python"
    printf '%s' "$json_list" | "$py_bin" -m json.tool >/dev/null 2>&1 || json_ok=0
    for jf in "$PSTORE_TMP"/*.json; do
        "$py_bin" -m json.tool "$jf" >/dev/null 2>&1 || json_ok=0
    done
fi
if [ "$json_ok" = 1 ] \
        && printf '%s\n' "$json_list" | grep -q 'plain app' \
        && grep -rq '"defaultBranch": "develop"' "$PSTORE_TMP"/*.json \
        && grep -rq 'plain%20app' "$PSTORE_TMP"/*.json \
        && grep -rq 'D%E1%BB%B1%20%C3%81n%20Vi%E1%BB%87t' "$PSTORE_TMP"/*.json; then
    ok "agy-projects writes valid percent-encoded git/folder JSON & lists them"
else
    bad "agy-projects writes valid percent-encoded git/folder JSON & lists them ($json_list)"
fi

scan_after="$(bash "$AGY_PROJ_BIN" scan "$DOCS_TMP")"
if [ -z "$scan_after" ]; then
    ok "agy-projects scan omits already-loaded folders"
else
    bad "agy-projects scan omits already-loaded folders ($scan_after)"
fi

if ! bash "$AGY_PROJ_BIN" remove outside-of-project >/dev/null 2>&1 \
        && bash "$AGY_PROJ_BIN" remove "plain app" >/dev/null 2>&1 \
        && bash "$AGY_PROJ_BIN" scan "$DOCS_TMP" | grep -q $'^new\tfolder\tplain app\t'; then
    ok "agy-projects remove unlinks project and protects outside-of-project"
else
    bad "agy-projects remove unlinks project and protects outside-of-project"
fi

unset AGY_PROJECTS_DIR AGY_DOCS_DIR
rm -rf "$PROJ_TMP"

rm -rf "$(dirname "$PREFIX")"
printf '== failures: %s ==\n' "$fail"
[ "$fail" = 0 ]
